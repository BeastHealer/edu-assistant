# GigaChat (Сбер). Получить: https://developers.sber.ru/gigachat
# Можно указать ключ авторизации (Authorization key) или логин/пароль клиента.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL_CERTS=false

# Опционально: OpenAI-совместимый endpoint (если GigaChat недоступен)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# Эмбеддинги: auto | gigachat | huggingface | tfidf
EMBEDDING_BACKEND=auto
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Пути (обычно не нужно менять)
KNOWLEDGE_DIR=data/knowledge
CHROMA_DIR=data/chroma
ANALYTICS_DB=data/analytics/queries.db
LMS_DIR=data/lms
